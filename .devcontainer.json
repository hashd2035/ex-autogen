{
  // https://medium.com/@jamiekt/vscode-devcontainer-with-zsh-oh-my-zsh-and-agnoster-theme-8adf884ad9f6

  // Optional: Set name for your container
  "name": "Python 3.12.5 Pyenv Poetry",
  
  
  // Uncomment and modify the image or Dockerfile path if you want to use a specific base image or custom Dockerfile
  // "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Uncomment if using Docker Compose to set up multi-container environments
  // "dockerComposeFile": "docker-compose.yml",
  // "service": "web"

  // Uncomment to set features (pre-configured setups, like Docker, Node.js)
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/mikaello/devcontainer-features/modern-shell-utils:1": {},
    "ghcr.io/devcontainers-contrib/features/pre-commit:2": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  
  // Uncomment to set mounting options for filesystems
  // "mounts": [
  //   "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
  
  //   "source=devcontainer-bash,target=/commandhistory,type=volume"
    
  //   // "source=/workspace,target=/app,type=bind"
  // ],

  // Uncomment to install VS Code extensions automatically inside the container
  "customizations": {
    "vscode": {
      // Specify extensions to install in the container
      "extensions": [
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "johnpapa.vscode-peacock",
        "timonwong.shellcheck",
        "robertz.code-snapshot",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ],
  
      // Customize VS Code settings (including shell)
      "settings": {
        "editor.tabsize": 4,
        "terminal.integrated.defaultProfile.linux": "zsh", // Default shell in VS Code terminal
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          },
          "fish": {
            "path": "fish"
          },
          "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
          },
          "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
          }
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "dotfiles": {
        "repository": "https://github.com/hashd2035/dotfiles",  // Replace with your dotfiles repo URL
        "targetPath": "~/",  // Where to clone the dotfiles (default is HOME)
        "installCommand": "~/install.sh"  // Optional: Command to install or apply dotfiles
      }
    }
  },
  // Uncomment to run commands after the container is created (e.g., installing dependencies)
  // "postCreateCommand": "pip install -r requirements.txt",
  "postCreateCommand": "poetry install && poetry run pip install jupyter && echo 'Workspace is at ${workspaceFolder}'",


  // Uncomment to forward ports from the container to your local machine
  // "forwardPorts": [3000, 8000],

  // Optional: Specify workspace folder inside the container
  "workspaceFolder": "/workspace",
  "remoteUser": "root",  // Use root user to avoid permission issues

  "forwardPorts": [8888],  // Port for Jupyter in the container
  "portsAttributes": {
    "50001": {
      "label": "External Docker Port"
    }
  }

  // Optional: Set additional container environment variables
  // "containerEnv": {
  //   "MY_ENV_VAR": "value"
  // },
}
